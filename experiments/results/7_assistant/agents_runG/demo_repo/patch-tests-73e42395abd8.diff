+from tinyshop.pricing import *  # noqa: F403
+from tinyshop.pricing import line_total
+
+def test_line_total_with_positive_price_and_quantity():
+    price = 10.5
+    qty = 3
+    expected_result = 31.5
+    assert line_total(price, qty) == expected_result
+
+def test_line_total_with_zero_price_and_quantity():
+    price = 0
+    qty = 5
+    expected_result = 0
+    assert line_total(price, qty) == expected_result
+
+def test_line_total_with_negative_price_and_quantity():
+    price = -10.5
+    qty = 3
+    expected_result = -31.5
+    assert line_total(price, qty) == expected_result
