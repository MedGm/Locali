+from tinyshop.pricing import *  # noqa: F403
+from tinyshop.pricing import line_total
+
+def test_example_1():
+    price = 50
+    qty = 3
+    expected_result = 150.0
+    assert line_total(price, qty) == expected_result
+
+def test_example_2():
+    price = 100
+    qty = 4
+    expected_result = 400.0
+    assert line_total(price, qty) == expected_result
+
+def test_zero_quantity():
+    price = 50
+    qty = 0
+    expected_result = 0.0
+    assert line_total(price, qty) == expected_result
