+from tinyshop.cli import main
+
+import argparse
+import io
+import sys
+
+
+
+
+def test_calc():
+    captured_output = io.StringIO()
+    sys.stdout = captured_output
+    main(['calc', '8.5*3'])
+    sys.stdout = sys.__stdout__
+    assert captured_output.getvalue().strip() == '25.5'
