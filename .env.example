# Copy to .env and fill in. Never commit .env.

# Backend (uv run uvicorn backend.app:default_app --factory)
LOCALI_API_TOKEN=            # required; the web app sends it on every call
LOCALI_REPOS_ROOT=.          # only folders under this one can be analysed
LOCALI_DATA_DIR=data/backend # runs, patches, audit log

# Model server (llama.cpp llama-server or vLLM, OpenAI-compatible)
LOCALI_MODEL_URL=http://127.0.0.1:8093/v1
LOCALI_MODEL_KEY=            # the server's --api-key
LOCALI_MODEL_NAME=local
LOCALI_MODEL_ID=ft-q8        # which entry of backend/models.json is running

# MLflow (optional)
LOCALI_MLFLOW_URI=sqlite:///data/mlflow.db
LOCALI_MLFLOW_UI=http://127.0.0.1:5000

# Web app (frontend/.env.local)
LOCALI_API_URL=http://127.0.0.1:8000

# Hugging Face, only for pushing models and datasets
HF_TOKEN=
