# Copy to .env and fill in. Never commit .env.
# Read by the backend, the web app (frontend/next.config.ts) and scripts/run.sh.
# A variable set in the shell wins over the file.

# Backend
LOCALI_API_TOKEN=change-me          # any long random string; the web app sends it on every call
LOCALI_API_URL=http://127.0.0.1:8000
LOCALI_REPOS_ROOT=.                 # only folders under this one can be analysed
LOCALI_DATA_DIR=data/backend        # runs, patches, audit log

# The assistant's model (scripts/run.sh model)
LOCALI_MODEL_FILE=/path/to/qwen2.5-coder-3b-locali-mixv3b-q4_k_m.gguf
LOCALI_MODEL_URL=http://127.0.0.1:8093/v1
LOCALI_MODEL_KEY=change-me          # any random string; the model server requires it
LOCALI_MODEL_NAME=local
LOCALI_MODEL_ID=ft3b-q4             # which entry of backend/models.json this is
# LOCALI_SPEC=none                  # n-gram lookup is on by default (scripts/run.sh)

# Optional second model, shown beside the first in the playground (scripts/run.sh compare)
# LOCALI_COMPARE_FILE=/path/to/qwen2.5-coder-1.5b-qlora-v2-q4_k_m.gguf
# LOCALI_COMPARE_URL=http://127.0.0.1:8094/v1
# LOCALI_COMPARE_KEY=change-me
# LOCALI_COMPARE_ID=ft-q4

# llama.cpp server binary, if not ~/tools/llama.cpp/build/bin/llama-server
# LOCALI_LLAMA_SERVER=

# MLflow (optional)
# LOCALI_MLFLOW_URI=sqlite:///data/mlflow.db
# LOCALI_MLFLOW_UI=http://127.0.0.1:5000

# Hugging Face, only for pushing models and datasets
HF_TOKEN=
