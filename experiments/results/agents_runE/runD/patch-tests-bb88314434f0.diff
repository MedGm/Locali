+from tinyshop.pricing import *  # noqa: F403
+from tinyshop.pricing import line_total
+
+def test_line_total_with_positive_numbers():
+    price = 10.99
+    qty = 3
+    expected_result = 32.97
+    assert line_total(price, qty) == expected_result
+
+def test_line_total_with_zero_quantity():
+    price = 10.99
+    qty = 0
+    expected_result = 0.0
+    assert line_total(price, qty) == expected_result
+
+def test_line_total_with_negative_price():
+    price = -10.99
+    qty = 3
+    expected_result = -32.97
+    assert line_total(price, qty) == expected_result
