# Copy to .env and fill in. Never commit .env.

# Hugging Face (read for models, write for pushing adapters)
HF_TOKEN=

# OpenAI-compatible inference endpoint (llama.cpp server locally, vLLM on Kaggle)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5-coder-1.5b-instruct

# Experiment tracking
MLFLOW_TRACKING_URI=file:./mlruns
